  "legal": {
    "banner": null,
    "deadlineMemoTitle": {
      "ru": "Важно: нельзя просрочить оплату патента даже на 1 день!",
      "tg": "Муҳим: пардохти патентро ҳатто 1 рӯз дер накунед!"
    },
    "deadlineMemoBullets": [
      {
        "ru": "Авансовый платёж за патент нужно вносить ЗАРАНЕЕ — строго до даты начала следующего оплачиваемого периода (даты выдачи патента). Рекомендуется платить за 3–5 дней до срока.",
        "tg": "Пардохти патент бояд ПЕШАКӢ — то санаи оғози давраи навбатии патент (санаи додани патент) супорида шавад. Беҳтараш 3–5 рӯз пештар пардохт кунед."
      },
      {
        "ru": "Просрочка даже на 1 день или уплата неполной суммы (например, без доплаты +50% за каждого ребёнка в РФ с 2027 года) автоматически аннулирует патент.",
        "tg": "Агар пардохт ҳатто 1 рӯз дер шавад ё маблағ камтар супорида шавад (масалан, бе иловапулии +50% барои ҳар кӯдак дар соли 2027), патент ба таври худкор бекор мешавад."
      },
      {
        "ru": "Если патент аннулирован или не продлён, необходимо выехать из России в течение 15 дней вместе с несовершеннолетними детьми, а подать на новый патент можно будет только через 1 год.",
        "tg": "Ҳангоми бекор шудани патент шумо бояд дар муддати 15 рӯз ҳамроҳи фарзандони ноболиғ Русияро тарк кунед ва гирифтани патенти нав ба мӯҳлати 1 сол манъ мешавад."
      },
      {
        "ru": "Для обладателей РВП и ВНЖ при работе у физлиц: уведомите МВД в течение 10 дней со дня начала работы, вовремя вносите ежемесячный платёж и сохраняйте все чеки для ежегодного уведомления.",
        "tg": "Барои дорандагони РВП ва ВНЖ, ки назди шахси воқеӣ кор мекунанд: дар муддати 10 рӯз аз оғози кор ба МВД хабар диҳед, пешпардохтро саривақт супоред ва ҳамаи расидҳо (чекҳо)-ро нигоҳ доред."
      }
    ],
    "disclaimer": {
      "ru": "Расчёт носит справочный характер (ст. 227.1 НК РФ, Федеральные законы № 241-ФЗ и № 242-ФЗ от 26.07.2026). Somoni не является государственным сервисом МВД или ФНС. Перед оплатой сверяйте сумму в официальной квитанции.",
      "tg": "Ҳисоб маълумоти иттилоотӣ мебошад (ст. 227.1 НК РФ, Қонунҳои федералии № 241-ФЗ ва № 242-ФЗ аз 26.07.2026). Somoni хадамоти расмии МВД ё ФНС нест. Пеш аз пардохт маблағро дар расиди расмӣ санҷед."
    }
  },
